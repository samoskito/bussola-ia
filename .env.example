# URL da aplicacao
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL usada nos links de e-mail (se vazio, usa APP/NEXT_PUBLIC_APP_URL)
EMAIL_APP_URL=

# Configuracoes do Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Obrigatoria para operacoes de backend (API routes)
SUPABASE_SERVICE_ROLE_KEY=

# Configuracoes SMTP (email de "esqueci minha senha")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Fallback HTTP API da Brevo (opcional, recomendado em serverless)
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_NAME=Bussola IA

# Tornar true antes da migration de convites e manter true ao desligar o painel.
# Impede fallback legado se RPC instalada ficar indisponivel/cache desatualizado.
PASSWORD_RESET_ATOMIC_REQUIRED=false

# Chave secreta para JWT
JWT_SECRET=

# Configuracao de ambiente
NODE_ENV=development

# Insights: manter desativado ate validar migrations, acesso e orçamento.
# Demo e permitido apenas em desenvolvimento; nenhuma conversa real e lida.
INSIGHTS_MODE=disabled
INSIGHTS_OPENAI_ENABLED=false
INSIGHTS_PROCESSING_ENABLED=false
INSIGHTS_MAX_SPEND_USD=0
INSIGHTS_BUDGET_SCOPE=insights-pilot
# Approved provider model. Production pilot uses gpt-5.4-nano after access check.
INSIGHTS_MODEL=gpt-5.4-nano
# Optional fixed comma-separated source IDs (1..200 unique positive integers).
# Do not define an empty value: omit until an approved pilot manifest exists.
INSIGHTS_CRON_SECRET=
OPENAI_API_KEY=

# MCP remoto: preparar/configurar e aplicar SOMENTE a migration OAuth revisada
# antes de ativar. Segredos novos; nunca reutilizar JWT/OpenAI/worker/service role.
INSIGHTS_MCP_ENABLED=false
INSIGHTS_MCP_BASE_URL=
INSIGHTS_MCP_CONSENT_SECRET=
# Array JSON server-only: clientId,name,clientSecretHash(SHA256),redirectUris.
# Cada cliente tem segredo aleatorio proprio (>=32 bytes); apenas hash no servidor.
INSIGHTS_MCP_CLIENTS_JSON=[]
# Compartilhamento textual exige revisao/autorizacao especifica, nao aceite geral.
INSIGHTS_MCP_EXAMPLES_ENABLED=false
# list_student_questions/get_student_question: texto integral das perguntas dos alunos
# (somente admins; sem nome/e-mail/telefone). Pseudonimos derivam do CONSENT_SECRET.
INSIGHTS_MCP_QUESTIONS_ENABLED=false

# Administracao de usuarios: demo somente local; sem gravacao/envio real.
ADMIN_USERS_MODE=disabled
ADMIN_USERS_LIVE_ENABLED=false
ADMIN_USERS_WRITES_ENABLED=false
ADMIN_USERS_EMAIL_ENABLED=false
# Origem fixa HTTPS de producao para convite, nunca derivada de headers.
ADMIN_USERS_APP_URL=
