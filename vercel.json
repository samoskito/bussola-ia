{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    { "path": "/api/hotmart/reprocess", "schedule": "*/15 * * * *" }
  ],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://bussola-ia.vercel.app"
  }
}
